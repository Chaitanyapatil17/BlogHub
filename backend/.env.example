PORT=5000

# OPTION 1: Cloud PostgreSQL Connection String (e.g. Neon.tech, Supabase, Render)
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# OPTION 2: Local PostgreSQL Configuration
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bloghub

# OPTIONAL: Meta Instagram Graph API Configuration
# INSTAGRAM_ACCESS_TOKEN=your_meta_access_token_here
# INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id

# Canonical Production Domain for dynamic sitemap.xml & robots.txt
SITE_URL=http://localhost:5173

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_here

# Cloudflare Turnstile Bot Protection Secret Key (Backend)
# Get from: https://dash.cloudflare.com/?to=/:account/turnstile
CLOUDFLARE_TURNSTILE_SECRET_KEY=your_cloudflare_turnstile_secret_key_here

