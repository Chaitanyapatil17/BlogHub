# Frontend Environment Variables (.env)

# Backend API URL (defaults to http://localhost:5000 in local dev)
VITE_API_URL=http://localhost:5000

# Cloudflare Turnstile Bot Protection Site Key (Public Frontend Key)
# Get from: https://dash.cloudflare.com/?to=/:account/turnstile
VITE_CLOUDFLARE_TURNSTILE_SITE_KEY=your_cloudflare_turnstile_site_key_here
